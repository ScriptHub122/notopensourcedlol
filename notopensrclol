local Character         = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Heartbeat         = RunService.Heartbeat
local WalkLoopRunning   = false

-- Get all players excluding local
local function GetPlayerList(): {string}
    local list: {string} = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

-- Teleport walk logic
local function TpWalk()
    WalkLoopRunning = true
    local char = Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end

    while WalkLoopRunning and char and hum and hum.Parent do
        local dt = Heartbeat:Wait()
        if hum.MoveDirection.Magnitude > 0 then
            char:TranslateBy(hum.MoveDirection * dt * 10 * TpWalkSpeed)
        end
    end
end

-- Distance helper
local function GetDistance(a: Vector3, b: Vector3): number
    return (a - b).Magnitude
end

-- Find player with lowest health
local function GetLowestHealthPlayer(): Player?
    local target: Player? = nil
    local minHealth = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local hum = p.Character and p.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 and hum.Health < minHealth then
                minHealth = hum.Health
                target = p
            end
        end
    end
    return target
end

-- Find closest player
local function GetClosestPlayer(): Player?
    local charRoot = Character and Character:FindFirstChild("HumanoidRootPart")
    if not charRoot then return nil end
    local pos = charRoot.Position
    local target: Player? = nil
    local minDist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character and p.Character:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = GetDistance(pos, root.Position)
                if dist < minDist then
                    minDist = dist
                    target = p
                end
            end
        end
    end
    return target
end

-- Smooth move to position
local function MoveTo(cf: CFrame)
    pcall(function()
        local root = Character and Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local targetPos = cf.Position - cf.LookVector * BehindDistance
        targetPos += Vector3.new(0, HeightOffset, 0)
        local goalCF = CFrame.new(targetPos, cf.Position)
        local dist = (goalCF.Position - root.Position).Magnitude
        local tween = TweenService:Create(root, TweenInfo.new(dist / TweenSpeed, Enum.EasingStyle.Linear), {CFrame = goalCF})
        tween:Play()
        tween.Completed:Connect(function()
            if not root.Parent then tween:Cancel() end
        end)
    end)
end

-- Main auto-farm loop
task.spawn(function()
    while true do
        task.wait(1e-11)
        if not _G.OBBY then continue end

        -- Ensure character exists
        if not Character or not Character:FindFirstChild("HumanoidRootPart") then
            repeat
                task.wait(0.1)
                Character = LocalPlayer.Character
            until Character and Character:FindFirstChild("HumanoidRootPart")
        end

        -- Select target
        local target = TargetMode == "Lowest Health Player" and GetLowestHealthPlayer() or GetClosestPlayer()
        if not target or not target.Character then continue end
        local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot then continue end

        -- Maintain position
        local root = Character:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        BodyVelocity = root:FindFirstChild("Main") or Instance.new("BodyVelocity", root)
        BodyVelocity.Name = "Main"
        BodyVelocity.Velocity = Vector3.zero
        BodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)

        MoveTo(targetRoot.CFrame)
    end
end)

