-- Update character reference reliably
local function UpdateCharacter()
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end
UpdateCharacter()

-- Get all players excluding local
local function GetPlayerList(): {string}
    local list: {string} = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

-- Distance helper
local function GetDistance(a: Vector3, b: Vector3): number
    return (a - b).Magnitude
end

-- Find player with lowest health
local function GetLowestHealthPlayer(): Player?
    local target: Player? = nil
    local minHealth = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
            if hum and hum.Health > 0 and hum.Health < minHealth then
                minHealth = hum.Health
                target = p
            end
        end
    end
    return target
end

-- Find closest player
local function GetClosestPlayer(): Player?
    if not Character then return nil end
    local root = Character:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return nil end
    local pos = root.Position
    local target: Player? = nil
    local minDist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
            local pHum = p.Character and p.Character:FindFirstChild("Humanoid") :: Humanoid?
            if pRoot and pHum and pHum.Health > 0 then
                local dist = GetDistance(pos, pRoot.Position)
                if dist < minDist then
                    minDist = dist
                    target = p
                end
            end
        end
    end
    return target
end

-- Smooth move to position
local function MoveTo(cf: CFrame)
    pcall(function()
        if not Character then return end
        local root = Character:FindFirstChild("HumanoidRootPart") :: BasePart?
        if not root then return end
        local targetPos = cf.Position - cf.LookVector * BehindDistance
        targetPos += Vector3.new(0, HeightOffset, 0)
        local goalCF = CFrame.new(targetPos, cf.Position)
        local dist = (goalCF.Position - root.Position).Magnitude
        local tween = TweenService:Create(root, TweenInfo.new(dist / TweenSpeed, Enum.EasingStyle.Linear), {CFrame = goalCF})
        tween:Play()
        tween.Completed:Connect(function()
            if not root.Parent then
                tween:Cancel()
            end
        end)
    end)
end

-- Teleport walk logic
local function TpWalk()
    WalkLoopRunning = true
    UpdateCharacter()
    if not Character then return end
    local hum = Character:FindFirstChildWhichIsA("Humanoid") :: Humanoid?
    if not hum then return end

    task.spawn(function()
        while WalkLoopRunning and Character and hum and hum.Parent do
            local dt = Heartbeat:Wait()
            if hum.MoveDirection.Magnitude > 0 then
                Character:TranslateBy(hum.MoveDirection * dt * 10 * TpWalkSpeed)
            end
            task.wait()
        end
    end)
end

-- Main auto-farm loop
task.spawn(function()
    while true do
        task.wait(1e-11)
        if not _G.OBBY then continue end

        -- Ensure character exists
        if not Character or not (Character :: Model):FindFirstChild("HumanoidRootPart") then
            repeat
                task.wait(0.1)
                UpdateCharacter()
            until Character and (Character :: Model):FindFirstChild("HumanoidRootPart")
        end

        -- Select target
        local target = TargetMode == "Lowest Health Player" and GetLowestHealthPlayer() or GetClosestPlayer()
        if not target or not target.Character then continue end
        local targetRoot = target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
        if not targetRoot then continue end

        -- Maintain position
        local root = (Character :: Model):FindFirstChild("HumanoidRootPart") :: BasePart?
        if not root then continue end
        BodyVelocity = root:FindFirstChild("Main") :: Instance? or Instance.new("BodyVelocity", root)
        BodyVelocity.Name = "Main"
        BodyVelocity.Velocity = Vector3.zero
        BodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)

        MoveTo(targetRoot.CFrame)
    end
end)

