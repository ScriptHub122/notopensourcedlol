-- Skill Keys Helper
local function SkillToggle(optionName: string, displayName: string, key: Enum.KeyCode)
    Tabs.Main:AddToggle(optionName, { Title = displayName, Default = false })
    Fluent.Options[optionName]:OnChanged(function()
        _G[optionName] = Fluent.Options[optionName].Value
        task.spawn(function()
            while _G[optionName] do
                VirtualInput:SendKeyEvent(true, key, false, game)
                VirtualInput:SendKeyEvent(false, key, false, game)
                task.wait(0.1)
            end
        end)
    end)
end

