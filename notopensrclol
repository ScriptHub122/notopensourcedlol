-- Configurable variables
local TweenSpeed        = 100
local TpWalkSpeed       = 5
local BehindDistance    = 5
local HeightOffset      = 0
local SelectedTarget: Player? = nil
local TargetMode        = "Closest Player"
local BodyVelocity: Instance? = nil

