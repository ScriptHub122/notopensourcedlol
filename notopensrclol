local function GetPlayerList(): {string}
    local list: {string} = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

local function GetDistance(a: Vector3, b: Vector3): number
    return (a - b).Magnitude
end

local function GetLowestHealthPlayer(): Player?
    local target: Player? = nil
    local minHealth = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local hum = p.Character and p.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 and hum.Health < minHealth then
                minHealth = hum.Health
                target = p
            end
        end
    end
    return target
end

local function GetClosestPlayer(): Player?
    local charRoot = Character and Character:FindFirstChild("HumanoidRootPart")
    if not charRoot then return nil end
    local pos = charRoot.Position
    local target: Player? = nil
    local minDist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character and p.Character:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = GetDistance(pos, root.Position)
                if dist < minDist then
                    minDist = dist
                    target = p
                end
            end
        end
    end
    return target
end

local function MoveTo(cf: CFrame)
    pcall(function()
        local root = Character and Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local targetPos = cf.Position - cf.LookVector * BehindDistance
        targetPos += Vector3.new(0, HeightOffset, 0)
        local goalCF = CFrame.new(targetPos, cf.Position)
        local dist = (goalCF.Position - root.Position).Magnitude
        local tween = TweenService:Create(root, TweenInfo.new(dist / TweenSpeed, Enum.EasingStyle.Linear), {CFrame = goalCF})
        tween:Play()
    end)
end

local function TpWalk()
    WalkLoopRunning = true
    local char = Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end
    while WalkLoopRunning and char and hum and hum.Parent do
        local dt = Heartbeat:Wait()
        if hum.MoveDirection.Magnitude > 0 then
            char:TranslateBy(hum.MoveDirection * dt * 10 * TpWalkSpeed)
        end
    end
end

